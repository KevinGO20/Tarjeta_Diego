---
const { name, color, url, icon: Icon, target } = Astro.props;
---

<a
  class="boton"
  style={`background:${color}`}
  href={url}
  target={target}
  rel="noopener noreferrer"
>
  <Icon /><span>{name}</span></a
>

<style>
  .boton {
    text-decoration: none;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    font-size: 0.8rem;
    padding: 5px;
    border: 1px solid white;
    border-radius: 15px;
    gap: 10px;
  }

  .boton > svg {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
  }

  .boton > span {
    width: 80px;
    font-size: 1rem;
  }
</style>
