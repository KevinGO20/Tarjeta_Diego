---
const { name, color, url, icon: Icon, target, className } = Astro.props;
---

<a
  class=`boton ${className}`
  style={`background:${color}`}
  href={url}
  target={target}
  rel="noopener noreferrer"
>
  <Icon /><span>{name}</span></a
>

<style>
  .boton {
    text-decoration: none;
    min-height: 40px;
    width: 100%;
    height: 35px;

    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    font-size: 1.5rem;
    padding: 5px;
    border: 1px solid white;
    border-radius: 15px;
    gap: 10px;
    position: relative;
    overflow: hidden;
  }

  .boton::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -60%;
    width: 30px;
    height: 200%;
    background: rgba(255, 255, 255, 0.4);
    transform: rotate(30deg);
    transition: none;
  }

  .boton:hover::after {
    left: 130%;
    transition: left 0.6s ease-in-out;
  }

  .boton > svg {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
  }

  .boton > span {
    width: 80px;
    font-size: 1rem;
  }
</style>
